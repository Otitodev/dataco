# DataHub (see app/integrations/datahub.py -> create_datahub_client)
DATAHUB_PROVIDER=datahub                    # datahub | fake
DATAHUB_URL=http://localhost:8080           # GMS API port (UI is 9002)
DATAHUB_TOKEN=your-datahub-token            # unset -> factory falls back to the seeded fake

# LLM layer (see app/integrations/llm.py -> create_llm_client)
LLM_PROVIDER=anthropic          # anthropic | openai | stub
# LLM_MODEL: optional override; leave blank to use the provider default.
# Keep the comment on its own line — an inline comment on an empty value is
# mis-parsed by python-dotenv (uvicorn --env-file) as the value itself.
LLM_MODEL=

# Anthropic (Claude) — default model claude-opus-4-8
ANTHROPIC_API_KEY=your-anthropic-api-key   # unset -> factory falls back to the stub

# OpenAI (GPT) — default model gpt-4o
OPENAI_API_KEY=your-openai-api-key         # unset -> factory falls back to the stub
OPENAI_MODEL=gpt-4o

# Continuous scanning (see app/services/scheduler.py)
# 0 (default) -> off. >0 runs the scan agent every N seconds with no human
# trigger — the agent watches the catalog on its own (see GET /scan/status).
SCAN_INTERVAL_SECONDS=0

DATABASE_URL=sqlite:///./dataco.db
BACKEND_URL=http://localhost:8000
